# ---- Personal data: never published ----
# Your own room (autosaved) and the room you had before the last New/Open
configs/my_house*.json
# Presets you save (house / weather / mix); the folder itself is kept by .gitkeep
configs/presets/*/
# Phone sharing settings (on/off, pairing key) and phone rooms
configs/remote.json
configs/zones/
# Secrets / local overrides
.env
.env.*

# ---- Local working notes and snapshots ----
backups/
HIM_CODEX*.md
docs/RELEASE_v*-wip.md
.claude/
*.bak
*.orig

